PORT=3000
NODE_ENV=development

# Database
# IMPORTANT: Use Transaction pooling mode (port 6543) instead of Session mode (port 5432)
# Transaction mode supports 6000+ concurrent connections vs 15-20 in Session mode
# Example: postgresql://postgres.xxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=your_postgresql_connection_string

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Redis (Optional - system works without it)
# Example: redis://localhost:6379
# Example: redis://:password@redis-host:6379
REDIS_URL=your_redis_connection_string

# Keep-alive (Render)
API_URL=http://localhost:3000

# Sentry (Optional - keep disabled locally unless testing)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=edu-maths-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0
